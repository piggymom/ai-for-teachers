// Prisma schema for AI for Teachers
// NextAuth.js + Progress tracking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// NextAuth.js required models
model User {
  id              String               @id @default(cuid())
  name            String?
  email           String?              @unique
  emailVerified   DateTime?
  image           String?
  accounts        Account[]
  sessions        Session[]
  progress        Progress[]
  profile         UserProfile?
  skippyMessages  SkippyMessage[]
  ledgers         ConversationLedger[]
  artifacts       Artifact[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Progress tracking model
model Progress {
  id         String   @id @default(cuid())
  userId     String
  weekNumber Int
  status     String   @default("not_started") // "not_started" | "in_progress" | "completed"
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber])
  @@index([userId])
}

// Skippy chat messages
model SkippyMessage {
  id        String   @id @default(cuid())
  userId    String
  week      Int
  role      String   // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, week])
  @@index([createdAt])
}

// User onboarding profile
model UserProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Step 1: Who You Are
  role               String
  roleOther          String?
  gradeLevels        String[] // ["PreK", "K", "1-2", etc.]
  subjects           String[] // User-entered tags

  // Step 2: Your Situation
  aiExperienceLevel  String   // "new" | "some" | "advanced"
  constraints        String?

  // Step 3: What You Want
  biggestTimeDrains  String[] // ["Lesson planning", "Differentiation", etc.]
  primaryGoal        String   // save_time | better_materials | faster_feedback | handle_admin | build_confidence
  goalDetails        String   // Renamed from 'goals' - Skippy-depth free-text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Conversation Ledger for tracking session state
// Used by Skippy to maintain awareness of conversation progress,
// teacher readiness level, and artifact development
model ConversationLedger {
  id                       String   @id @default(cuid())

  // Core identifiers
  userId                   String
  weekNumber               Int

  // Phase tracking
  currentPhase             String   @default("DISCOVER") // DISCOVER|BUILD|REFINE|REFLECT|SAVE|BRIDGE
  phaseHistory             String[] @default(["DISCOVER"])
  exchangeCount            Int      @default(0)

  // Diagnostic data (teacher readiness assessment)
  diagnosticAssessed       Boolean  @default(false)
  diagnosticLevel          String?  // pre-structural|unistructural|multistructural|relational|extended-abstract
  diagnosticEvidence       String?  @db.Text
  diagnosticReadyFor       String?
  diagnosticMisconceptions String[] @default([])

  // Session summary
  sessionSummary           String   @default("") @db.Text

  // Artifact tracking
  artifactInProgress       Boolean  @default(false)
  artifactType             String?  // prompt_template|workflow|draft_feedback|lesson_outline|email_template|etc.
  artifactState            String?  @db.Text
  artifactIterations       Int      @default(0)

  // 4C component tracking (Week 2)
  fourCContext              Boolean  @default(false)
  fourCConstraints          Boolean  @default(false)
  fourCCommand              Boolean  @default(false)
  fourCCriteria             Boolean  @default(false)

  // Redirect tracking
  redirectCount             Int      @default(0)

  // Engagement signals
  engagementEnergy         String   @default("medium") // high|medium|low
  engagementNotes          String?

  // Guidance for next turn
  guidance                 String?

  // Timestamps
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekNumber])
  @@index([userId])
}

// Extracted artifacts from conversations
// Prompts, templates, workflows saved during SAVE phase
model Artifact {
  id          String   @id @default(cuid())

  // Ownership
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Context
  weekNumber  Int
  weekTopic   String   // e.g., "Prompting Fundamentals" - denormalized for display

  // Content
  title       String   // Generated or extracted, e.g., "Differentiated Fractions Prompt"
  type        String   // prompt_template | workflow | lesson_outline | draft_feedback | email_template | etc.
  content     String   @db.Text  // The actual artifact

  // Metadata
  description String?  // Optional 1-2 sentence summary
  tags        String[] @default([])  // For future filtering/search

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, weekNumber])
}
